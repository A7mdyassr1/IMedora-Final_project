# Which concrete DataProvider to use. "mock" works with zero setup.
DATA_PROVIDER=mock

# LLM provider - leave as "mock" until you have a real API key.
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_API_KEY=

# Embedding provider - leave as "mock" until Phase AI-6/7 wires a real one.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding

# Vector store backend.
VECTOR_STORE_TYPE=local

# Only used once DATA_PROVIDER=backend (the backend doesn't exist yet).
BACKEND_API_BASE_URL=
