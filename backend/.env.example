# ------------------------------------------------------------------
# IMedora backend - environment variables (TEMPLATE ONLY, no real values)
#
# WHERE THESE GO: the backend reads the REPOSITORY-ROOT .env file
# (the same file database/ uses for DATABASE_URL), or real environment
# variables, which take precedence. Copy the lines you need from here
# into <repo-root>/.env. A file named backend/.env is NOT read.
#
# Never commit a real .env (it is git-ignored).
# ------------------------------------------------------------------

# --- Required -------------------------------------------------------
# PostgreSQL connection (psycopg2 driver). Same value database/ uses.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/imedora

# JWT signing key: at least 32 random characters. The API refuses to start without it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<generate-a-long-random-value>

# --- Optional (defaults shown) ------------------------------------
APP_ENV=development                 # development | test | production
# JWT_ALGORITHM=HS256               # HS256 | HS384 | HS512
ACCESS_TOKEN_EXPIRE_MINUTES=480     # 1..1440; default = one 8-hour shift

# Connection pool
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_CONNECT_TIMEOUT=5

# Comma-separated browser origins allowed by CORS (the future web frontend).
# The Flutter app is not a browser and does not need an entry here.
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=true                       # false = plain text logs for local work

# --- Tests only -------------------------------------------------------
# A DISPOSABLE database that must be named exactly imedora_test, migrated with
# `alembic upgrade head`. When unset, the PostgreSQL integration tests are skipped.
# TEST_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/imedora_test

# --- scripts/create_user.py only (automation) ---------------------------
# Normally the script asks for the password in a hidden prompt; set this only in CI.
# IMEDORA_USER_PASSWORD=
