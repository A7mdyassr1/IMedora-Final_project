# ------------------------------------------------------------------
# IMedora — Example Environment Variables
# Copy this file to .env and fill in real values locally.
# NEVER commit the actual .env file.
# ------------------------------------------------------------------

# --- General ---
ENVIRONMENT=development
APP_NAME=IMedora
APP_PORT=8000

# --- Backend / API ---
SECRET_KEY=
API_V1_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000

# --- AI Service ---
AI_SERVICE_URL=http://localhost:8100
AI_API_KEY=

# --- Auth (placeholders — finalize once auth strategy is chosen) ---
JWT_SECRET=
JWT_EXPIRES_IN=

# --- Object Storage (for attachments, future use) ---
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
